# Copy this file to .env.local and fill in your key. NEVER commit .env.local
#
# Default provider: Groq (free tier). Get a key at https://console.groq.com/keys
LLM_API_KEY=gsk_your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- To use xAI Grok instead, replace the three lines above with: ---
# LLM_API_KEY=xai-your-key-here        (key from https://console.x.ai)
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.7
